# ---------------------------------------------------------------
# GridWise - example environment file
# Copy this to `.env` (gitignored) and fill in real secrets.
# Never commit `.env` or any key.
# ---------------------------------------------------------------

# --- LLM provider selection ---
# openai | anthropic | google | groq | stub
#   stub   -> deterministic offline fallback (NOT acceptable for live judging)
#   groq   -> uses GROQ_API_KEY (OpenAI-compatible Chat Completions API)
GRIDWISE_LLM_PROVIDER=groq

# --- Model ---
# Groq model names (verified end-to-end against the public sample set):
#   qwen/qwen3.8-27b        (recommended - passes all 10 sample cases)
#   openai/gpt-oss-120b     (alternative - higher capacity, slower)
#   openai/gpt-oss-20b      (alternative - lower capacity)
# Other providers' example model ids: gpt-4o-mini, claude-3-5-haiku-latest,
# gemini-1.5-flash.
#
# Note: qwen/qwen3-32b and llama-3.1-8b-instant are NOT available on
# Groq's free tier at the time of writing. Use qwen/qwen3.8-27b.
GRIDWISE_LLM_MODEL=qwen/qwen3.8-27b

# Override the API base URL only when using a proxy or self-hosted
# OpenAI-compatible gateway. Leave blank for the public endpoint.
GRIDWISE_LLM_BASE_URL=

# --- Provider-specific API keys ---
# Required when GRIDWISE_LLM_PROVIDER is groq.
GROQ_API_KEY=your-groq-api-key-here

# Generic alias used by openai / anthropic / google providers. Kept for
# backward compatibility; Groq will read GROQ_API_KEY above first.
LLM_API_KEY=

# --- Solver ---
GRIDWISE_SOLVER_TIME_LIMIT=15
GRIDWISE_SOLVER_MIP_GAP=0.001
GRIDWISE_SOLVER_THREADS=1

# --- HTTP / logging ---
GRIDWISE_LLM_TIMEOUT=30
GRIDWISE_LLM_MAX_RETRIES=3
GRIDWISE_LOG_LEVEL=INFO
GRIDWISE_ALLOW_OFFLINE=0
GRIDWISE_TOL=0.01
