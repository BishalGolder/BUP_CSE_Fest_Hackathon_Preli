# --- LLM provider selection ---
# openai | anthropic | google | stub
GRIDWISE_LLM_PROVIDER=stub
GRIDWISE_LLM_MODEL=gpt-4o-mini
GRIDWISE_LLM_BASE_URL=

# Required when GRIDWISE_LLM_PROVIDER != stub
LLM_API_KEY=LLM_API_KEY

# --- Solver ---
GRIDWISE_SOLVER_TIME_LIMIT=15
GRIDWISE_SOLVER_MIP_GAP=0.001
GRIDWISE_SOLVER_THREADS=1

# --- HTTP / logging ---
GRIDWISE_LLM_TIMEOUT=30
GRIDWISE_LLM_MAX_RETRIES=3
GRIDWISE_LOG_LEVEL=INFO
GRIDWISE_ALLOW_OFFLINE=1
GRIDWISE_TOL=0.01
